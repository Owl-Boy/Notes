.05955675,0.05290532,-0.04299041,0.07230095,0.02871501,-0.00787863,0.05379438,0.00157367,0.03076633,0.1115692,0.0001372,-0.01355173,-0.01873614,0.03229773,0.02810974,-0.02347023,-0.02084687,-0.03506675,-0.01965439,-0.10482222,0.03020479,0.1097677,-0.01326421,-0.02563149,0.00353977,0.04324484,0.0170992,-0.0092871,0.03977445,0.00140918,-0.02390144,0.01779003,0.0413548,-0.04488639,-0.03000237,-0.03186215,0.00272886,0.02471507,-0.00935586,-0.01916337,0.02339708,-0.03250346],"tokens":371}},"embedding":{},"history":[],"class_name":"SmartSource","blocks":{"#":[1,15],"#---frontmatter---":[6,15],"#Additive Structure of number rings":[16,51],"#Additive Structure of number rings#{1}":[17,26],"#Additive Structure of number rings##Theorem 1":[27,51],"#Additive Structure of number rings##Theorem 1#{1}":[28,35],"#Additive Structure of number rings##Theorem 1###Proof:":[36,48],"#Additive Structure of number rings##Theorem 1###Proof:#{1}":[37,48],"#Additive Structure of number rings##Theorem 1#Thus, we get $A \\subset R \\subset \\mathbb{Z}\\frac{\\alpha_{1}}{d} \\oplus \\mathbb{Z} \\frac{\\alpha_{2}}{d} \\oplus \\dots \\oplus \\mathbb{Z} \\frac{\\alpha_{n}}{d}$. Thus $R$ is sandwiched between two free groups of rank $n$, thus it has rank $n$ (refer [[Free Group]]). Equivalently, $R$ has a basis over $\\mathbb{Z}$, this basis is called an **integral basis** for $R$.":[49,51],"#Additive Structure of number rings##Theorem 1#Thus, we get $A \\subset R \\subset \\mathbb{Z}\\frac{\\alpha_{1}}{d} \\oplus \\mathbb{Z} \\frac{\\alpha_{2}}{d} \\oplus \\dots \\oplus \\mathbb{Z} \\frac{\\alpha_{n}}{d}$. Thus $R$ is sandwiched between two free groups of rank $n$, thus it has rank $n$ (refer [[Free Group]]). Equivalently, $R$ has a basis over $\\mathbb{Z}$, this basis is called an **integral basis** for $R$.#{1}":[51,51],"#Discriminant of a number ring":[52,214],"#Discriminant of a number ring##Theorem 2:":[53,83],"#Discriminant of a number ring##Theorem 2:#{1}":[54,57],"#Discriminant of a number ring##Theorem 2:###Proof:":[58,81],"#Discriminant of a number ring##Theorem 2:###Proof:#{1}":[59,81],"#Discriminant of a number ring##Theorem 2:#Therefore, the discriminant of an integral basis can be regarded as an invariant of the ring $R$. Denote it by $\\mathrm{disc}(R)$.":[82,83],"#Discriminant of a number ring##Proposition 1:":[84,95],"#Discriminant of a number ring##Proposition 1:#{1}":[85,88],"#Discriminant of a number ring##Proposition 1:###Proof:":[89,95],"#Discriminant of a number ring##Proposition 1:###Proof:#{1}":[90,95],"#Discriminant of a number ring##Theorem 3:":[96,106],"#Discriminant of a number ring##Theorem 3:#{1}":[97,103],"#Discriminant of a number ring##Theorem 3:###Proof:":[104,106],"#Discriminant of a number ring##Theorem 3:###Proof:#{1}":[105,106],"#Discriminant of a number ring##Lemma 1:":[107,154],"#Discriminant of a number ring##Lemma 1:#{1}":[108,111],"#Discriminant of a number ring##Lemma 1:###Proof:":[112,154],"#Discriminant of a number ring##Lemma 1:###Proof:#{1}":[113,154],"#Discriminant of a number ring##Corollary 1:":[155,160],"#Discriminant of a number ring##Corollary 1:#{1}":[156,160],"#Discriminant of a number ring##Corollary 2:":[161,169],"#Discriminant of a number ring##Corollary 2:#{1}":[162,165],"#Discriminant of a number ring##Corollary 2:###Proof:":[166,169],"#Discriminant of a number ring##Corollary 2:###Proof:#{1}":[167,169],"#Discriminant of a number ring##Theorem 4:":[170,214],"#Discriminant of a number ring##Theorem 4:#{1}":[171,178],"#Discriminant of a number ring##Theorem 4:###Proof:":[179,214],"#Discriminant of a number ring##Theorem 4:###Proof:#{1}":[180,214],"#Properties of Number Rings":[215,235],"#Properties of Number Rings##Theorem 5:":[216,235],"#Properties of Number Rings##Theorem 5:#{1}":[217,220],"#Properties of Number Rings##Theorem 5:###Proof:":[221,235],"#Properties of Number Rings##Theorem 5:###Proof:#{1}":[222,235],"#References":[236,242],"#References#{1}":[237,242]},"mtime":1703166363221,"size":12114,"hash":"b20da4239ab8dfcf2d76565d75bc7f5bbc413f2cbeaa5b800bfe221609145262","last_read_hash":"b20da4239ab8dfcf2d76565d75bc7f5bbc413f2cbeaa5b800bfe221609145262","outlinks":[{"title":"Number Theory","target":"Number Theory","line":4},{"title":"Free Group","target":"Free Group","line":49},{"title":"Cyclotomic Fields","target":"Cyclotomic Fields","line":167},{"title":"Algebraic Integers","target":"Algebraic Integers","line":229},{"title":"Number Field","target":"Number Field","line":237},{"title":"Trace and Norm","target":"Trace and Norm","line":238},{"title":"Free Group","target":"Free Group","line":239},{"title":"Cyclotomic Fields","target":"Cyclotomic Fields","line":240},{"title":"Algebraic Integers","target":"Algebraic Integers","line":241},{"title":"Dedekind Domains","target":"Dedekind Domains","line":242}]}
